MEDIA_UID=1100
MEDIA_GID=1100
SAMBA_DOWNLOAD_USER=download
SAMBA_DOWNLOAD_PASSWORD=change-me-download
SAMBA_MUSIC_USER=music
SAMBA_MUSIC_PASSWORD=change-me-music
SAMBA_WORKGROUP=WORKGROUP
SAMBA_USERID=1100
