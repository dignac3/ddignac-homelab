# VPN sidecar (gluetun) - ProtonVPN via WireGuard
# Get WIREGUARD_PRIVATE_KEY from: ProtonVPN dashboard > Downloads > WireGuard
# configuration > pick a "P2P" labeled server, copy the "PrivateKey" line.
# WIREGUARD_ADDRESSES is NOT needed for protonvpn (gluetun handles it internally).
VPN_WIREGUARD_PRIVATE_KEY=
VPN_SERVER_COUNTRIES=France